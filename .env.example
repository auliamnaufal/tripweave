# Public URL of the app. PayPal's return_url / cancel_url are built from it.
# Leave empty locally (the request origin is used); set it in any deployment.
APP_BASE_URL=

# OpenAI API (planner agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Duffel (flight search + reprice; test-mode key from your Duffel dashboard)
DUFFEL_API_KEY=

# PayPal (sandbox by default)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Webhook id from PayPal Developer Dashboard → app → Webhooks. Without it,
# /api/webhooks/paypal refuses every delivery.
PAYPAL_WEBHOOK_ID=
# Optional: a PayPal *sandbox* personal account shown at checkout so judges can
# finish the demo payment. Public by design (NEXT_PUBLIC); sandbox only.
NEXT_PUBLIC_PAYPAL_SANDBOX_BUYER_EMAIL=
NEXT_PUBLIC_PAYPAL_SANDBOX_BUYER_PASSWORD=

# Supabase (Postgres + Auth). Apply supabase/migrations in order.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# More suppliers (optional; each adapter is skipped while its key is empty)
# LiteAPI hotels, sandbox key starts with sand_
LITEAPI_KEY=
# Travelpayouts / Aviasales Data API token (flight price comparison)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Channel3 product search (the trip page's "Pack for it" gear links; off while empty).
# Key from https://trychannel3.com/developers
CHANNEL3_API_KEY=
# AG Studio licence for the Trip spend dashboard (/insights). Empty: trial with a watermark.
AG_STUDIO_LICENSE_KEY=
# Viator Partner API (not used yet: the current key was refused)
VIATOR_API_KEY=

# Demo-only. Off in any real deployment.
# true: the earliest activity always fails booking and is refunded (issue #14),
# and /lab may hand-set an Onboarded Supplier payee.
DEMO_MODE=false

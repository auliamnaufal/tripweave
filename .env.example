# Command Code Provider API (hosted model)
COMMAND_CODE_API_KEY=
COMMAND_CODE_PROVIDER_BASE_URL=https://api.commandcode.ai/provider/v1
COMMAND_CODE_MODEL=deepseek/deepseek-v4-flash
# Optional: set 1 to enforce zero data retention on provider requests
COMMAND_CODE_ZDR=

# Duffel (flight search; test-mode key from your Duffel dashboard)
DUFFEL_API_KEY=

# PayPal (sandbox by default)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
